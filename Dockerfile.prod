FROM python:3.11-slim

# Variables d'environnement
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 


# Créer le répertoire de travail
WORKDIR /app

# Installer les dépendances système
RUN apt-get update && apt-get install -y \
    binutils \
    libproj-dev \
    gdal-bin \
    libgdal-dev \
    libgeos-dev \
    build-essential \
    gcc \
    g++ \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*


RUN ln -sf $(find /usr/lib -name "libgdal.so*" | head -1) /usr/lib/x86_64-linux-gnu/libgdal.so \
    && ln -sf $(find /usr/lib -name "libgeos_c.so*" | head -1) /usr/lib/x86_64-linux-gnu/libgeos_c.so

RUN find /usr -name "libgdal*" && find /usr -name "libgeos_c*" && echo "GDAL_LIBRARY_PATH: $(find /usr -name 'libgdal*')" && echo "GEOS_LIBRARY_PATH: $(find /usr -name 'libgeos_c*')"
# Variable d’environnement requise par GeoDjango



# Copier les requirements
COPY requirements.txt .

# Installer les dépendances Python
RUN pip install --upgrade pip && pip install -r requirements.txt

# Copier le projet
COPY . .


# Créer les dossiers nécessaires
RUN mkdir -p staticfiles media

# Entrypoint
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]